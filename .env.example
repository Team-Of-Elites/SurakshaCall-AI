LLM_MODEL=qwen3:4b
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOCAL_NETWORK_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
SESSION_TOKEN=local-dev-token
DEMO_AUDIO_DIR=data/demo
MAX_QUEUE_SIZE=100
NORMAL_INTERVAL_SECONDS=10
HIGH_RISK_INTERVAL_SECONDS=4
MINIMUM_NEW_WORDS=12
LLM_TIMEOUT_SECONDS=6
STRUCTURED_RETRY_COUNT=1
AUDIO_SAMPLE_RATE=16000
ANALYSIS_CHUNK_SECONDS=2.0
MAX_AUDIO_BUFFER_SECONDS=20
SAVE_RAW_AUDIO=false
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
MOBILE_TRANSCRIPTION_CHUNK_SECONDS=3
RISK_THRESHOLD_MEDIUM=40
RISK_THRESHOLD_HIGH=70
RISK_THRESHOLD_CRITICAL=85
CLEAR_SESSION_ON_END=true
LOG_REDACTED_ONLY=true
